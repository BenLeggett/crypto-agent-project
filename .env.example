# Local/dev defaults are paper-first and mock-safe.
APP_MODE=paper
APP_EXECUTION=dry_run
CONFIG_ENV=dry_run
APP_SERVICE_NAME=crypto-agent-project
RUN_ID_PREFIX=local
TRADING_FOUNDATION=freqtrade
LOG_LEVEL=INFO
LOG_FORMAT=structured

# Paper compose/runtime defaults. These are local artifact and image settings,
# not live trading credentials.
PAPER_RUN_ID=paper-local
PAPER_CONFIG_HASH=paper-local-config
PAPER_HEARTBEAT_INTERVAL_SECONDS=60
PAPER_JOURNAL_PATH=data/journals/paper-runtime.jsonl
PAPER_EVENT_PACKET_PATH=data/event_packets/paper-runtime.jsonl
PAPER_PYTHON_IMAGE=python:3.11-slim
PAPER_FREQTRADE_IMAGE=freqtradeorg/freqtrade:stable

# Optional local universe overrides for future collector/strategy slices.
SYMBOLS=
TIMEFRAMES=

# Deterministic risk controls remain enabled and live execution remains disabled.
RISK_ENABLED=true
LIVE_EXECUTION_ENABLED=false
RISK_LIVE_EXECUTION_ENABLED=false
REQUIRES_PROMOTION_MARKER=true

# Exchange/API credentials are human-wired later. Do not commit real values.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

# AI provider credentials are optional and must only be used through apps/ai_router.
AI_PROVIDER=mock
AI_DEFAULT_MODEL_TIER=cheap
AI_PREMIUM_ENABLED=false
OPENAI_API_KEY=

# Operator delivery remains mocked until a human wires an approved destination.
OPERATOR_UPDATE_WEBHOOK_URL=
OPERATOR_UPDATE_BOT_TOKEN=
OPERATOR_UPDATE_CHANNEL_ID=

# Agent orchestrator local-LLM diagnostics are optional and advisory only.
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_LOW_MODEL=
LOCAL_LLM_MEDIUM_MODEL=
LOCAL_LLM_LOW_TIMEOUT_SECONDS=30
LOCAL_LLM_LOW_MAX_TOKENS=256
LOCAL_LLM_MEDIUM_WARMUP_TIMEOUT_SECONDS=120
LOCAL_LLM_MEDIUM_TIMEOUT_SECONDS=180
LOCAL_LLM_MEDIUM_MAX_TOKENS=600
LOCAL_LLM_UNLOAD_MEDIUM_AFTER_REVIEW=false
LOCAL_LLM_RETRY_ATTEMPTS=2
LOCAL_LLM_RETRY_BACKOFF_SECONDS=1
LOCAL_VALIDATION_SUMMARY=failures_only
DISCORD_WEBHOOK_RETRY_ATTEMPTS=3
DISCORD_WEBHOOK_RETRY_BACKOFF_SECONDS=1
OPERATOR_EVENT_POLL_SECONDS=1

# Optional Freqtrade-native operator surfaces remain disabled by default.
FREQTRADE_TELEGRAM_TOKEN=
FREQTRADE_TELEGRAM_CHAT_ID=
FREQTRADE_API_USERNAME=
FREQTRADE_API_PASSWORD=
