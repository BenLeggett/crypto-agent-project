# Local/dev defaults are paper-first and mock-safe.
APP_MODE=paper
APP_EXECUTION=dry_run
CONFIG_ENV=dry_run
APP_SERVICE_NAME=crypto-agent-project
RUN_ID_PREFIX=local
TRADING_FOUNDATION=freqtrade
LOG_LEVEL=INFO
LOG_FORMAT=structured

# Optional local universe overrides for future collector/strategy slices.
SYMBOLS=
TIMEFRAMES=

# Deterministic risk controls remain enabled and live execution remains disabled.
RISK_ENABLED=true
LIVE_EXECUTION_ENABLED=false
RISK_LIVE_EXECUTION_ENABLED=false
REQUIRES_PROMOTION_MARKER=true

# Exchange/API credentials are human-wired later. Do not commit real values.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

# AI provider credentials are optional and must only be used through apps/ai_router.
AI_PROVIDER=mock
AI_DEFAULT_MODEL_TIER=cheap
AI_PREMIUM_ENABLED=false
OPENAI_API_KEY=

# Operator delivery remains mocked until a human wires an approved destination.
OPERATOR_UPDATE_WEBHOOK_URL=
OPERATOR_UPDATE_BOT_TOKEN=
OPERATOR_UPDATE_CHANNEL_ID=

# Optional Freqtrade-native operator surfaces remain disabled by default.
FREQTRADE_TELEGRAM_TOKEN=
FREQTRADE_TELEGRAM_CHAT_ID=
FREQTRADE_API_USERNAME=
FREQTRADE_API_PASSWORD=
