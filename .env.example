# Local/dev defaults are paper-first and mock-safe.
APP_MODE=paper
CONFIG_ENV=dry_run
LOG_LEVEL=INFO

# Exchange/API credentials are human-wired later. Do not commit real values.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

# AI provider credentials are optional and must only be used through apps/ai_router.
OPENAI_API_KEY=

# Operator delivery remains mocked until a human wires an approved destination.
OPERATOR_UPDATE_WEBHOOK_URL=
OPERATOR_UPDATE_BOT_TOKEN=
OPERATOR_UPDATE_CHANNEL_ID=
